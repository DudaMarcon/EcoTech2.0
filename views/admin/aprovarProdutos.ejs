
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Aprovar produtos | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="/css/admin.css">

    <style>
        .product-card {
            background: white;
            border: 1px solid #e8ece8;
            border-radius: 8px;
            padding: 22px;
            margin-bottom: 18px;
        }

        .product-image {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 6px;
            background: #f1f3f1;
        }

        .product-info h3 {
            font-size: 18px;
            font-weight: 600;
        }

        .product-info p {
            color: #68736b;
            font-size: 13px;
            margin-bottom: 7px;
        }

        .product-price {
            color: #194b32;
            font-weight: 700;
            font-size: 18px;
        }

        .btn-approve {
            background: #194b32;
            color: white;
        }

        .btn-approve:hover {
            background: #286641;
            color: white;
        }

        .btn-reject {
            background: #fff;
            color: #b33a3a;
            border: 1px solid #b33a3a;
        }

        .btn-reject:hover {
            background: #b33a3a;
            color: white;
        }

        @media(max-width: 600px) {
            .product-image {
                width: 100%;
                height: 200px;
            }
        }
    </style>
</head>

<body>

<div class="admin-layout">

    <aside class="sidebar">

        <div class="brand">
            <h3>EcoTech<span>.</span></h3>
            <small>ADMINISTRAÇÃO</small>
        </div>

        <div class="menu-label">MENU PRINCIPAL</div>

        <nav class="sidebar-nav">

            <a href="/admin" class="nav-item">
                <span class="nav-icon">▦</span>
                Visão geral
            </a>

            <a href="/admin/aprovar-produtos" class="nav-item active">
                <span class="nav-icon">▤</span>
                Aprovar produtos
            </a>

            <a href="/admin/usuarios" class="nav-item">
                <span class="nav-icon">♙</span>
                Usuários
            </a>

            <a href="/admin/produtos" class="nav-item">
                <span class="nav-icon">▧</span>
                Produtos
            </a>

            <a href="/admin/eletronicos" class="nav-item">
                <span class="nav-icon">♻</span>
                Eletrônicos
            </a>

        </nav>

        <div class="sidebar-footer">
            <a href="/">← Voltar ao site</a>
        </div>

    </aside>

    <main class="main-content">

        <header class="topbar">

            <div>
                <span class="breadcrumb-text">
                    EcoTech / Administração
                </span>

                <h1>Aprovar produtos</h1>
            </div>

            <div class="user-info">
                <div class="user-avatar">A</div>

                <div>
                    <strong><%= nomeAdmin %></strong>
                    <small>Administrador</small>
                </div>
            </div>

        </header>

        <div class="content-area">

            <div class="welcome-section">
                <h2>Produtos aguardando análise</h2>

                <p>
                    Confira as informações dos produtos antes
                    de disponibilizá-los na loja.
                </p>
            </div>

            <% if (produtos.length === 0) { %>

                <div class="empty-state">
                    <span>✓</span>
                    <p>
                        Não existem produtos aguardando aprovação.
                    </p>
                </div>

            <% } %>

            <% produtos.forEach(produto => { %>

                <div class="product-card">

                    <div class="row g-4 align-items-center">

                        <div class="col-12 col-md-auto">

                            <% if (produto.imagens && produto.imagens[0]) { %>

                                <img
                                    src="<%= produto.imagens[0] %>"
                                    class="product-image"
                                    alt="Foto do produto"
                                >

                            <% } else { %>

                                <div class="product-image d-flex align-items-center justify-content-center">
                                    Sem imagem
                                </div>

                            <% } %>

                        </div>

                        <div class="col product-info">

                            <h3><%= produto.nome %></h3>

                            <p>
                                <strong>Categoria:</strong>
                                <%= produto.categoria || "Não informada" %>
                            </p>

                            <p>
                                <strong>Marca:</strong>
                                <%= produto.marca || "Não informada" %>
                            </p>

                            <p>
                                <strong>Modelo:</strong>
                                <%= produto.modelo || "Não informado" %>
                            </p>

                            <p>
                                <strong>Estado:</strong>
                                <%= produto.estado || "Não informado" %>
                            </p>

                            <p>
                                <strong>Problema:</strong>
                                <%= produto.problema || "Não informado" %>
                            </p>

                            <p>
                                <strong>Descrição:</strong>
                                <%= produto.descricaoCompleta || "Sem descrição" %>
                            </p>

                            <p class="product-price">
                                R$ <%= Number(produto.preco || 0).toFixed(2).replace(".", ",") %>
                            </p>

                            <div class="d-flex flex-wrap gap-2 mt-3">

                                <form
                                    action="/admin/aprovar-produto/<%= produto.id %>"
                                    method="POST"
                                    onsubmit="return confirm('Deseja aprovar este produto?')"
                                >
                                    <button class="btn btn-approve btn-sm px-3">
                                        Aprovar produto
                                    </button>
                                </form>

                                <form
                                    action="/admin/rejeitar-produto/<%= produto.id %>"
                                    method="POST"
                                    onsubmit="return confirm('Deseja rejeitar este produto?')"
                                >
                                    <button class="btn btn-reject btn-sm px-3">
                                        Rejeitar
                                    </button>
                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            <% }); %>

            <footer class="admin-footer">
                EcoTech © 2026 — Administração da plataforma
            </footer>

        </div>

    </main>

</div>

</body>
</html>
