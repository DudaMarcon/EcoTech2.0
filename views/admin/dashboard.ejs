<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Administração | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <div class="admin-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                <h3>EcoTech<span>.</span></h3>
                <small>ADMINISTRAÇÃO</small>
            </div>

            <div class="menu-label">MENU PRINCIPAL</div>

            <nav class="sidebar-nav">

                <a href="/admin" class="nav-item active">
                    <span class="nav-icon">▦</span>
                    Visão geral
                </a>

                <a href="/admin/aprovar-produtos" class="nav-item">
                    <span class="nav-icon">▤</span>
                    Aprovar produtos
                </a>

                <a href="/admin/usuarios" class="nav-item">
                    <span class="nav-icon">♙</span>
                    Usuários
                </a>

                <a href="/admin/produtos" class="nav-item">
                    <span class="nav-icon">▧</span>
                    Produtos
                </a>

                <a href="/admin/eletronicos" class="nav-item">
                    <span class="nav-icon">♻</span>
                    Eletrônicos
                </a>

            </nav>

            <div class="sidebar-footer">
                <a href="/">← Voltar ao site</a>
            </div>

        </aside>

        <!-- CONTEÚDO -->
        <main class="main-content">

            <header class="topbar">

                <div>
                    <span class="breadcrumb-text">EcoTech / Administração</span>
                    <h1>Visão geral</h1>
                </div>

                <div class="user-info">
                    <div class="user-avatar">A</div>

                    <div>
                        <strong>
                            <%= nomeAdmin %>
                        </strong>
                        <small>Administrador</small>
                    </div>
                </div>

            </header>

            <div class="content-area">

                <!-- INTRODUÇÃO -->
                <section class="welcome-section">

                    <div>
                        <h2>Bem-vindo à administração.</h2>

                        <p>
                            Gerencie os cadastros e acompanhe as atividades
                            da plataforma EcoTech.
                        </p>
                    </div>

                </section>

                <!-- INDICADORES -->

                <section class="stats-section">

                    <div class="stat-item">
                        <span>Usuários cadastrados</span>
                        <strong>
                            <%= totalUsuarios %>
                        </strong>
                        <small>Total de contas</small>
                    </div>

                    <div class="stat-item">
                        <span>Produtos cadastrados</span>
                        <strong>
                            <%= totalProdutos %>
                        </strong>
                        <small>Total de anúncios</small>
                    </div>

                    <div class="stat-item">
                        <span>Aguardando aprovação</span>
                        <strong>
                            <%= produtosPendentes %>
                        </strong>
                        <small>Precisam de análise</small>
                    </div>

                </section>


                <!-- APROVAÇÃO -->
                <section class="approval-section">

                    <div class="approval-content">

                        <div>
                            <span class="section-overline">
                                MODERAÇÃO DA PLATAFORMA
                            </span>

                            <h3>Produtos aguardando aprovação</h3>

                            <p>
                                Analise os produtos enviados pelos usuários
                                antes de disponibilizá-los para compra.
                            </p>
                        </div>

                        <a href="/admin/aprovar-produtos" class="btn-approval">
                            Analisar produtos →
                        </a>

                    </div>

                </section>

                <!-- ATIVIDADES -->
                <section class="activity-section">

                    <div class="section-heading">
                        <div>
                            <h3>Atividades recentes</h3>
                            <p>Acompanhe as movimentações da plataforma.</p>
                        </div>
                    </div>

                    <div class="empty-state">
                        <span>—</span>
                        <p>As atividades recentes aparecerão aqui.</p>
                    </div>

                </section>

                <footer class="admin-footer">
                    EcoTech © 2026 — Administração da plataforma
                </footer>

            </div>

        </main>

    </div>

</body>

</html>