<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Eletrônicos | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

<div class="admin-layout">

    <aside class="sidebar">

        <div class="brand">
            <h3>EcoTech<span>.</span></h3>
            <small>ADMINISTRAÇÃO</small>
        </div>

        <div class="menu-label">MENU PRINCIPAL</div>

        <nav class="sidebar-nav">

            <a href="/admin" class="nav-item">
                <span class="nav-icon">▦</span> Visão geral
            </a>

            <a href="/admin/aprovar-produtos" class="nav-item">
                <span class="nav-icon">▤</span> Aprovar produtos
            </a>

            <a href="/admin/usuarios" class="nav-item">
                <span class="nav-icon">♙</span> Usuários
            </a>

            <a href="/admin/produtos" class="nav-item">
                <span class="nav-icon">▧</span> Produtos
            </a>

            <a href="/admin/eletronicos" class="nav-item active">
                <span class="nav-icon">♻</span> Eletrônicos
            </a>

        </nav>

        <div class="sidebar-footer">
            <a href="/">← Voltar ao site</a>
        </div>

    </aside>

    <main class="main-content">

        <header class="topbar">

            <div>
                <span class="breadcrumb-text">EcoTech / Administração</span>
                <h1>Eletrônicos</h1>
            </div>

            <div class="user-info">
                <div class="user-avatar">A</div>

                <div>
                    <strong><%= nomeAdmin %></strong>
                    <small>Administrador</small>
                </div>
            </div>

        </header>

        <div class="content-area">

            <section class="welcome-section">
                <h2>Eletrônicos cadastrados</h2>
                <p>Consulte os detalhes dos eletrônicos enviados à plataforma.</p>
            </section>

            <section class="admin-table-section">

                <div class="table-responsive">

                    <table class="table admin-table align-middle">

                        <thead>
                            <tr>
                                <th>Eletrônico</th>
                                <th>Marca / Modelo</th>
                                <th>Funcionamento</th>
                                <th>Problema</th>
                                <th>Situação</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (eletronicos.length === 0) { %>

                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        Nenhum eletrônico cadastrado.
                                    </td>
                                </tr>

                            <% } %>

                            <% eletronicos.forEach(produto => { %>

                                <tr>

                                    <td>
                                        <div class="table-product">

                                            <% if (produto.imagens && produto.imagens[0]) { %>

                                                <img src="<%= produto.imagens[0] %>" alt="Eletrônico">

                                            <% } else { %>

                                                <div class="product-placeholder">♻</div>

                                            <% } %>

                                            <strong><%= produto.nome || "Eletrônico" %></strong>

                                        </div>
                                    </td>

                                    <td>
                                        <strong><%= produto.marca || "Não informada" %></strong>
                                        <br>
                                        <small class="text-muted">
                                            <%= produto.modelo || "Modelo não informado" %>
                                        </small>
                                    </td>

                                    <td><%= produto.estado || "Não informado" %></td>

                                    <td><%= produto.problema || "Nenhum informado" %></td>

                                    <td>

                                        <span class="status-badge
                                            <%= produto.status === 'aprovado' ? 'status-approved' :
                                                produto.status === 'rejeitado' ? 'status-rejected' :
                                                'status-pending' %>">

                                            <%= produto.status === "aprovado" ? "Aprovado" :
                                                produto.status === "rejeitado" ? "Rejeitado" :
                                                "Pendente" %>

                                        </span>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

                <div class="table-footer">
                    Total de <strong><%= eletronicos.length %></strong> eletrônicos cadastrados.
                </div>

            </section>

            <footer class="admin-footer">
                EcoTech © 2026 — Administração da plataforma
            </footer>

        </div>

    </main>

</div>

</body>
</html>