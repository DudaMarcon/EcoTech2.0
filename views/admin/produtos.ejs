<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/img/ecotech-facicon-claro.svg?v=2">

    <title>Produtos | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <div class="admin-layout">

        <aside class="sidebar">

            <div class="brand">
                <h3>EcoTech<span>.</span></h3>
                <small>ADMINISTRAÇÃO</small>
            </div>

            <div class="menu-label">MENU PRINCIPAL</div>

            <nav class="sidebar-nav">

                <a href="/admin" class="nav-item">
                    <span class="nav-icon">▦</span> Visão geral
                </a>

                <a href="/admin/aprovar-produtos" class="nav-item">
                    <span class="nav-icon">▤</span> Aprovar produtos
                </a>

                <a href="/admin/usuarios" class="nav-item">
                    <span class="nav-icon">♙</span> Usuários
                </a>

                <a href="/admin/produtos" class="nav-item active">
                    <span class="nav-icon">▧</span> Produtos
                </a>

                <a href="/admin/eletronicos" class="nav-item">
                    <span class="nav-icon">♻</span> Eletrônicos
                </a>

            </nav>

            <div class="sidebar-footer">
                <a href="/">← Voltar ao site</a>
            </div>

        </aside>

        <main class="main-content">

            <header class="topbar">

                <div>
                    <span class="breadcrumb-text">EcoTech / Administração</span>
                    <h1>Produtos</h1>
                </div>

                <div class="user-info">
                    <div class="user-avatar">A</div>

                    <div>
                        <strong>
                            <%= nomeAdmin %>
                        </strong>
                        <small>Administrador</small>
                    </div>
                </div>

            </header>

            <div class="content-area">

                <section class="welcome-section">
                    <h2>Todos os produtos</h2>
                    <p>Acompanhe os anúncios enviados pelos usuários.</p>
                </section>

                <section class="admin-table-section">

                    <div class="table-responsive">

                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Categoria</th>
                                    <th>Preço</th>
                                    <th>Estado</th>
                                    <th>Status</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% if (produtos.length===0) { %>
                                    <tr>
                                        <td colspan="6">Nenhum produto cadastrado.</td>
                                    </tr>
                                    <% } %>

                                        <% produtos.forEach(produto=> { %>
                                            <tr>
                                                <td>
                                                    <%= produto.nome || "Sem nome" %>
                                                </td>

                                                <td>
                                                    <%= produto.categoria || "Não informado" %>
                                                </td>

                                                <td>
                                                    R$ <%= produto.preco || "0,00" %>
                                                </td>

                                                <td>
                                                    <%= produto.estado || produto.funcionamento || "Não informado" %>
                                                </td>

                                                <td>
                                                    <span class="status-badge">
                                                        <%= produto.status || "Sem status" %>
                                                    </span>
                                                </td>

                                                <td>
                                                    <form action="/admin/excluir-produto/<%= produto.id %>"
                                                        method="POST"
                                                        onsubmit="return confirm('Tem certeza que deseja excluir este produto? Essa ação não poderá ser desfeita.');">
                                                        <button type="submit" class="btn-delete-product">
                                                            <i class="bi bi-trash"></i>
                                                            Excluir
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <div class="table-footer">
                        Total de <strong>
                            <%= produtos.length %>
                        </strong> produtos cadastrados.
                    </div>

                </section>

                <footer class="admin-footer">
                    EcoTech © 2026 — Administração da plataforma
                </footer>

            </div>

        </main>

    </div>

</body>

</html>