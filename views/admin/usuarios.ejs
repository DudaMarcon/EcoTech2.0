<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Usuários | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

<div class="admin-layout">

    <aside class="sidebar">

        <div class="brand">
            <h3>EcoTech<span>.</span></h3>
            <small>ADMINISTRAÇÃO</small>
        </div>

        <div class="menu-label">MENU PRINCIPAL</div>

        <nav class="sidebar-nav">

            <a href="/admin" class="nav-item">
                <span class="nav-icon">▦</span> Visão geral
            </a>

            <a href="/admin/aprovar-produtos" class="nav-item">
                <span class="nav-icon">▤</span> Aprovar produtos
            </a>

            <a href="/admin/usuarios" class="nav-item active">
                <span class="nav-icon">♙</span> Usuários
            </a>

            <a href="/admin/produtos" class="nav-item">
                <span class="nav-icon">▧</span> Produtos
            </a>

            <a href="/admin/eletronicos" class="nav-item">
                <span class="nav-icon">♻</span> Eletrônicos
            </a>

        </nav>

        <div class="sidebar-footer">
            <a href="/">← Voltar ao site</a>
        </div>

    </aside>

    <main class="main-content">

        <header class="topbar">

            <div>
                <span class="breadcrumb-text">EcoTech / Administração</span>
                <h1>Usuários</h1>
            </div>

            <div class="user-info">
                <div class="user-avatar">A</div>

                <div>
                    <strong><%= nomeAdmin %></strong>
                    <small>Administrador</small>
                </div>
            </div>

        </header>

        <div class="content-area">

            <section class="welcome-section">
                <h2>Usuários cadastrados</h2>
                <p>Consulte as contas registradas na plataforma EcoTech.</p>
            </section>

            <section class="admin-table-section">

                <div class="table-responsive">

                    <table class="table admin-table align-middle">

                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>Tipo de conta</th>
                                <th>Cadastro</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (usuarios.length === 0) { %>

                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        Nenhum usuário cadastrado.
                                    </td>
                                </tr>

                            <% } %>

                            <% usuarios.forEach(usuario => { %>

                                <tr>

                                    <td>
                                        <strong><%= usuario.nome || "Sem nome" %></strong>
                                    </td>

                                    <td><%= usuario.email || "Não informado" %></td>

                                    <td>
                                        <span class="status-badge
                                            <%= usuario.tipo === 'admin' ? 'status-approved' : 'status-neutral' %>">
                                            <%= usuario.tipo === "admin" ? "Administrador" : "Usuário" %>
                                        </span>
                                    </td>

                                    <td>
                                        <% if (usuario.criadoEm) { %>
                                            <%= new Date(usuario.criadoEm).toLocaleDateString("pt-BR") %>
                                        <% } else { %>
                                            <span class="text-muted">Não informado</span>
                                        <% } %>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

                <div class="table-footer">
                    Total de <strong><%= usuarios.length %></strong> usuários cadastrados.
                </div>

            </section>

            <footer class="admin-footer">
                EcoTech © 2026 — Administração da plataforma
            </footer>

        </div>

    </main>

</div>

</body>
</html>