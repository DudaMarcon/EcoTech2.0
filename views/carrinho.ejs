<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Carrinho | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body>

    <%- include("partials/header") %>

        <main class="container my-5">

            <h1 class="fw-bold mb-4">
                <i class="bi bi-cart3"></i> Meu Carrinho
            </h1>

            <% if (produtos.length===0) { %>

                <div class="text-center py-5">
                    <i class="bi bi-cart-x display-1 text-secondary"></i>
                    <h3 class="mt-3">Seu carrinho está vazio</h3>
                    <p class="text-muted">Encontre produtos e adicione ao seu carrinho.</p>

                    <a href="/ecoProdutos" class="btn btn-success mt-2">
                        Explorar produtos
                    </a>
                </div>

                <% } else { %>

                    <div class="row g-4">

                        <div class="col-lg-8">

                            <% produtos.forEach(produto=> { %>

                                <div class="card mb-3 shadow-sm">
                                    <div class="card-body">

                                        <div class="row align-items-center">

                                            <div class="col-4 col-md-3">
                                                <img src="<%= produto.imagem %>" alt="<%= produto.nome %>"
                                                    class="img-fluid rounded"
                                                    style="height: 120px; width: 100%; object-fit: contain;">
                                            </div>

                                            <div class="col-8 col-md-9">
                                                <h5 class="fw-bold">
                                                    <%= produto.nome %>
                                                </h5>

                                                <p class="text-primary fw-bold mb-1">
                                                    R$ <%= produto.precoFormatado %>
                                                </p>

                                                <p class="text-muted mb-0">
                                                    Quantidade: <%= produto.quantidade %>
                                                </p>

                                                <p class="mb-0 mt-2">
                                                    Subtotal:
                                                    <strong>
                                                        R$ <%= produto.subtotal.toLocaleString("pt-BR", {
                                                            minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                                    </strong>
                                                </p>
                                                <button class="btn btn-outline-danger btn-sm"
                                                    onclick="removerProduto('<%= produto.id %>')">
                                                    <i class="bi bi-trash"></i> Remover
                                                </button>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                                <% }) %>

                        </div>

                        <div class="col-lg-4">

                            <div class="card shadow-sm">
                                <div class="card-body">

                                    <h4 class="fw-bold mb-3">Resumo do pedido</h4>

                                    <hr>

                                    <div class="d-flex justify-content-between mb-3">
                                        <span>Total</span>
                                        <strong class="text-success fs-4">
                                            R$ <%= total %>
                                        </strong>
                                    </div>

                                    <button class="btn btn-success" onclick="finalizarCompra()">
                                        Finalizar compra
                                    </button>

                                    <p class="text-muted small mt-2 mb-0">
                                        A finalização da compra será implementada posteriormente.
                                    </p>

                                    <a href="/ecoProdutos" class="btn btn-outline-secondary w-100 mt-3">
                                        Continuar comprando
                                    </a>

                                </div>
                            </div>

                        </div>

                    </div>

                    <% } %>

        </main>

        <%- include("partials/footer") %>

            <script>
                function finalizarCompra() {
                    alert("Esta funcionalidade está em desenvolvimento. Em breve estará disponível!");
                }
            </script>
            <script>
                async function removerProduto(idProduto) {
                    if (!confirm("Deseja realmente remover este produto do carrinho?")) {
                        return;
                    }

                    try {
                        const resposta = await fetch(
                            `/carrinho/remover/${encodeURIComponent(idProduto)}`,
                            { method: "DELETE" }
                        );

                        const resultado = await resposta.json();

                        if (!resposta.ok || !resultado.sucesso) {
                            alert(resultado.mensagem || "Erro ao remover produto.");
                            return;
                        }

                        alert(resultado.mensagem);
                        window.location.reload();

                    } catch (erro) {
                        console.error(erro);
                        alert("Erro de conexão ao remover o produto.");
                    }
                }
            </script>

</body>

</html>