<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= produto.nome %> | EcoTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body>

    <%- include("partials/header") %>

        <% const estado=(produto.estado || "" ) .toLowerCase() .trim(); let badgeClass="bg-secondary text-white" ; if (
            estado==="excelente" || estado==="funcionando normalmente" ) { badgeClass="bg-success text-white" ; } else
            if (estado==="bom" ) { badgeClass="bg-primary text-white" ; } else if ( estado==="regular" ||
            estado==="com defeito" ) { badgeClass="bg-warning text-dark" ; } else if (estado==="danificado" ) {
            badgeClass="bg-danger text-white" ; } else if ( estado==="não testado" || estado==="nao testado" ||
            estado==="nao_testado" ) { badgeClass="bg-secondary text-white" ; } const estadoFormatado=produto.estado ?
            produto.estado.charAt(0).toUpperCase() + produto.estado.slice(1).toLowerCase() : "Estado não informado" ; %>
            <main class="container my-5">
                <div class="row">
                    <!-- Galeria de Fotos -->
                    <div class="col-md-6">
                        <img src="<%= produto.imagens && produto.imagens.length > 0 ? produto.imagens[0] : '/img/eletronico-padrao.png' %>"
                            class="img-fluid rounded" alt="<%= produto.nome %>"
                            style="width: 100%; height: 400px; object-fit: contain;">

                    </div>

                    <!-- Informações e Botões -->
                    <div class="col-md-6">
                        <!-- Badge Dinâmico de Estado -->
                        <span class="badge mb-2 align-self-start <%= badgeClass %>">
                            <%= estadoFormatado %>
                        </span>

                        <h1>
                            <%= produto.nome %>
                        </h1>
                        <h3 class="text-primary fw-bold my-3">R$ <%= produto.preco %>
                        </h3>

                        <hr>

                        <h5>Descrição Completa</h5>
                        <p class="text-muted">
                            <%= produto.descricaoCompleta %>
                        </p>

                        <div class="d-grid gap-2 mt-4">
                            <!-- Botão de Comprar Agora -->
                            <button class="btn btn-success btn-lg" onclick="comprarAgora('<%= produto.id %>')">
                                <i class="bi bi-bag-check"></i> Comprar Agora
                            </button>

                            <!-- Botão de Adicionar ao Carrinho -->
                            <button class="btn btn-outline-primary btn-lg"
                                onclick="adicionarCarrinho('<%= produto.id %>')">
                                <i class="bi bi-cart-plus"></i> Adicionar ao Carrinho
                            </button>
                        </div>
                    </div>
                </div>
            </main>

            <%- include("partials/footer") %>

                <script>
                    function adicionarCarrinho(idProduto) {
                        alert("Produto " + idProduto + " adicionado ao carrinho!");
                    }

                    function comprarAgora(idProduto) {
                        window.location.href = "/checkout/" + idProduto;
                    }
                </script>
</body>

</html>