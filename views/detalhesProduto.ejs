
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= produto.nome %> | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body>

    <%- include("partials/header") %>

    <main class="container my-5">
        <div class="row">

            <!-- Galeria de Fotos -->
            <div class="col-md-6">
                <img
                    src="<%= produto.imagens && produto.imagens.length > 0 ? produto.imagens[0] : '/img/eletronico-padrao.svg' %>"
                    class="img-fluid rounded shadow-sm mb-3"
                    alt="<%= produto.nome %>"
                    id="imagemPrincipal"
                >
            </div>

            <!-- Informações e Botões -->
            <div class="col-md-6">

                <span class="badge bg-success mb-2">
                    Estado: <%= produto.estado %>
                </span>

                <h1><%= produto.nome %></h1>

                <h3 class="text-primary fw-bold my-3">
                    R$ <%= produto.preco %>
                </h3>

                <hr>

                <h5>Descrição Completa</h5>

                <p class="text-muted">
                    <%= produto.descricaoCompleta %>
                </p>

                <div class="d-grid gap-2 mt-4">

                    <!-- Botão Comprar Agora -->
                    <button
                        type="button"
                        class="btn btn-success btn-lg"
                        onclick="comprarAgora()"
                    >
                        <i class="bi bi-bag-check"></i>
                        Comprar Agora
                    </button>

                    <!-- Botão Adicionar ao Carrinho -->
                    <button
                        type="button"
                        class="btn btn-outline-primary btn-lg"
                        onclick="adicionarCarrinho('<%= produto.id %>')"
                    >
                        <i class="bi bi-cart-plus"></i>
                        Adicionar ao Carrinho
                    </button>

                </div>
            </div>
        </div>
    </main>

    <%- include("partials/footer") %>

    <script>
        // Adicionar produto ao carrinho
        async function adicionarCarrinho(idProduto) {
            try {
                const resposta = await fetch(
                    `/carrinho/adicionar/${encodeURIComponent(idProduto)}`,
                    {
                        method: "POST"
                    }
                );

                const resultado = await resposta.json();

                if (resposta.status === 401) {
                    alert("Você precisa entrar na sua conta.");
                    window.location.href = "/login";
                    return;
                }

                if (!resposta.ok || !resultado.sucesso) {
                    alert(
                        resultado.mensagem ||
                        "Não foi possível adicionar o produto."
                    );
                    return;
                }

                if (confirm("Produto adicionado ao carrinho! Deseja ir para o carrinho?")) {
                    window.location.href = "/carrinho";
                }

            } catch (erro) {
                console.error("Erro ao adicionar ao carrinho:", erro);
                alert("Erro de conexão. Tente novamente.");
            }
        }

        // Comprar agora
        function comprarAgora() {
            alert(
                "A funcionalidade de compra está em desenvolvimento. Em breve estará disponível!"
            );
        }
    </script>

</body>
</html>
