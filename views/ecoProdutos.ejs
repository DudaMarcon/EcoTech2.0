<!DOCTYPE html>
<html lang="pt-BR">

<head>
<link rel="icon" type="image/svg+xml" href="/img/ecotech-facicon-claro.svg?v=2">

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EcoProdutos | EcoTech</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS da EcoTech -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/footer.css">

</head>

<body>
    <%- include("partials/header") %>

<main class="container my-5">
        <h1>Nossos EcoProdutos</h1>
        <p>Conheça os produtos sustentáveis da EcoTech.</p>
    </main>

    <div class="container my-5">
    <h2 class="mb-4 text-center">Eletrônicos Recondicionados</h2>
    
    <div class="row row-cols-1 row-cols-md-3 g-4">
        
        <!-- ABRINDO O LOOP PARA PERCORRE A LISTA -->
        <% produtos.forEach(produto => { %>
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="<%= produto.imagens[0] %>" class="card-img-top p-3" alt="<%= produto.nome %>" style="height: 200px; object-fit: contain;">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-success mb-2 align-self-start"><%= produto.estado %></span>
                        <h5 class="card-title"><%= produto.nome %></h5>
                        <p class="card-text text-muted"><%= produto.descricaoCompleta %></p>
                        <div class="mt-auto">
                            <span class="fs-4 fw-bold text-primary d-block mb-3">R$ <%= produto.preco %></span>
                            
                            <!-- AGORA O ID PUXA CERTO DO ITEM ATUAL DO LOOP -->
                            <a href="/produto/<%= produto.id %>" class="btn btn-outline-primary w-100">
    <i class="bi bi-eye"></i> Ver Detalhes
</a>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
        <!-- FECHANDO O LOOP -->

    </div>
</div>
    <!-- =========================
         RODAPÉ
         ========================= -->

    <%- include("partials/footer") %>


    <!-- Bootstrap JavaScript -->

   
</body>

</html>