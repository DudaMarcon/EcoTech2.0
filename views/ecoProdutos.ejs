
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <link rel="icon" type="image/svg+xml" href="/img/ecotech-facicon-claro.svg?v=2">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EcoProdutos | EcoTech</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- CSS da página -->
    <link rel="stylesheet" href="/css/ecoProdutos.css">

    <!-- CSS geral da EcoTech -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/footer.css">
</head>

<body>

    <%- include("partials/header") %>

    <main class="container my-5">
        <h1>Nossos EcoProdutos</h1>
        <p>Conheça os produtos sustentáveis da EcoTech.</p>
    </main>

    <section class="container my-5">

        <h2 class="mb-4 text-center">
            Eletrônicos Recondicionados
        </h2>

        <div class="row row-cols-1 row-cols-md-3 g-4">

            <% if (produtos && produtos.length > 0) { %>

                <% produtos.forEach(produto => { %>

                    <div class="col">

                        <div class="card h-100 shadow-sm">

                            <!-- Imagem do produto -->
                            <img
                                src="<%= produto.imagens[0] %>"
                                class="img-fluid rounded shadow-sm mb-3"
                                alt="<%= produto.nome %>"
                                id="imagemPrincipal"
                                >

                            <div class="card-body d-flex flex-column">

                                <!-- Estado do produto e cor da etiqueta -->
                                <%
                                    const estado = (produto.estado || "")
                                        .toLowerCase()
                                        .trim();

                                    let badgeClass = "bg-secondary text-white";

                                    if (
                                        estado === "excelente" ||
                                        estado === "funcionando normalmente"
                                    ) {
                                        badgeClass = "bg-success text-white";
                                    } else if (estado === "bom") {
                                        badgeClass = "bg-primary text-white";
                                    } else if (
                                        estado === "regular" ||
                                        estado === "com defeito"
                                    ) {
                                        badgeClass = "bg-warning text-dark";
                                    } else if (estado === "danificado") {
                                        badgeClass = "bg-danger text-white";
                                    } else if (
                                        estado === "não testado" ||
                                        estado === "nao_testado"
                                    ) {
                                        badgeClass = "bg-secondary text-white";
                                    }
                                %>

                                <span class="badge mb-2 align-self-start <%= badgeClass %>">
                                    <%= produto.estado || "Estado não informado" %>
                                </span>

                                <!-- Nome -->
                                <h5 class="card-title">
                                    <%= produto.nome %>
                                </h5>

                                <!-- Descrição -->
                                <p class="card-text text-muted">
                                    <%= produto.descricaoCompleta || produto.descricao || produto.problema || "Sem descrição disponível." %>
                                </p>

                                <!-- Preço e botão -->
                                <div class="mt-auto">

                                    <span class="fs-4 fw-bold text-primary d-block mb-3">
                                        R$ <%= typeof produto.preco === "number"
                                            ? produto.preco.toLocaleString("pt-BR", {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            })
                                            : produto.preco %>
                                    </span>

                                    <a
                                        href="/produto/<%= produto.id %>"
                                        class="btn btn-outline-primary w-100"
                                    >
                                        <i class="bi bi-eye"></i>
                                        Ver Detalhes
                                    </a>

                                </div>

                            </div>
                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <!-- Mensagem caso não existam produtos -->
                <div class="col-12">
                    <div class="alert alert-info text-center" role="alert">
                        Nenhum eletrônico cadastrado no momento.
                    </div>
                </div>

            <% } %>

        </div>
    </section>

    <!-- Rodapé -->
    <%- include("partials/footer") %>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
