                                    <% } %>

                                        <!-- NOTIFICAÇÕES -->
                                        <li class="nav-item dropdown" id="areaNotificacoes">

                                            <button type="button" class="nav-link position-relative"
                                                id="botaoNotificacoes" aria-expanded="false" aria-label="Notificações">

                                                <i class="bi bi-bell fs-5"></i>

                                                <span id="contadorNotificacoes"
                                                    class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                                    style="display: none;">

                                                    0

                                                </span>

                                            </button>

                                            <a href="/carrinho" class="nav-link" title="Meu carrinho">
                                                <i class="bi bi-cart3 fs-5"></i>
                                            </a>


                                            <!-- MENU DE NOTIFICAÇÕES -->
                                            <div id="menuNotificacoes"
                                                class="dropdown-menu dropdown-menu-end notificacoes-menu p-3">

