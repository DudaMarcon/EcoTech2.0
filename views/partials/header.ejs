<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EcoTech</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/footer.css">
</head>

<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <!-- Logo / nome -->
            <a class="navbar-brand" href="/">
                EcoTech
            </a>

            <!-- Botão do menu no celular -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Links -->
            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Início
                        </a>
                    </li>

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                            aria-expanded="false">

                            Recicla

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item" href="/recicla#funciona">
                                    Como funciona
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/recicla#problemas">
                                    Impactos ambientais
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/recicla#impacto-ecotech">
                                    Impacto da EcoTech
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/recicla#impacto">
                                    Dados sobre o impacto
                                </a>
                            </li>

                        </ul>

                    </li>
                    <!-- Saiba mais -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">

                            Saiba mais

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item" href="/saibamais#sobre">
                                    Sobre a EcoTech
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#circular">
                                    Economia Circular
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#funciona">
                                    Como funciona
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#ecopontos">
                                    EcoPontos
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#lab">
                                    EcoTech Lab
                                </a>
                            </li>

                        </ul>

                    </li>

                    <!-- Login/Nome do usuário-->
                    <% if (nomeUsuario) { %>
                        <li class="nav-item">
                            <span class="nav-link fw-bold">
                                Olá, <%= nomeUsuario %>!
                            </span>
                        </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/login">
                                    Entrar
                                </a>
                            </li>

                            <% } %>

                </ul>

            </div>

        </div>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>