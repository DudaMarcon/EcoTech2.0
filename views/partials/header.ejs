                            <li class="nav-item">
                                <a class="nav-link" href="/admin">
                                    <i class="bi bi-speedometer2"></i>
                                    Painel Administrativo
                                </a>
                            </li>

            

                                <% } else { %>

                                    <li class="nav-item">
                                        <a class="nav-link" href="/usuario/dashboard">
                                            <i class="bi bi-person-circle"></i>
                                            Olá, <%= nomeUsuario %>!
                                        </a>
