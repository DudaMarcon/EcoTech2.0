                                                    <i class="bi bi-bell me-2"></i>

                                                    Notificações

                                                </h6>

                                                <div id="listaNotificacoes">

                                                    <p class="text-muted small mb-0">
                                                        Carregando notificações...
                                                    </p>

                                                </div>

                                            </div>

                                        </li>


                                        <!-- SAIR -->
                                        <li class="nav-item">

                                            <a class="nav-link" href="/logout" title="Sair">

                                                <img src="/img/sair.png" alt="Logout" width="25">

                                            </a>

                                        </li>


                                        <% } else { %>


                                            <!-- ENTRAR -->
                                            <li class="nav-item">

                                                <a class="nav-link" href="/login">
                                                    Entrar
                                                </a>

                                            </li>


                                            <% } %>

                </ul>

            </div>

        </div>

