<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <link rel="icon" type="image/svg+xml" href="/img/ecotech-facicon-claro.svg?v=2">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EcoTech</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/footer.css">

    <!-- Estilos da navbar e notificações -->
    <style>
        /* ====================================== */
        /* NOTIFICAÇÕES */
        /* ====================================== */

        #areaNotificacoes {
            position: relative;
            display: flex;
            align-items: center;
        }

        #botaoNotificacoes {
            background: transparent;
            border: none;
            color: inherit;
            cursor: pointer;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #botaoNotificacoes:hover {
            opacity: 0.8;
        }

        #botaoNotificacoes:focus {
            outline: none;
            box-shadow: none;
        }

        #contadorNotificacoes {
            font-size: 10px;
        }

        /* Menu de notificações */
        #menuNotificacoes {
            position: absolute;
            top: 100%;
            right: 0;
            left: auto;
            width: 320px;
            max-width: 90vw;
            max-height: 400px;
            overflow-y: auto;
            z-index: 2000;
        }

        /* Exibir menu quando clicado */
        #menuNotificacoes.show {
            display: block;
        }

        /* ====================================== */
        /* SAUDAÇÃO */
        /* ====================================== */

        .saudacao-desktop {
            align-items: center;
        }

        .saudacao-desktop .nav-link {
            white-space: nowrap;
        }

        /* ====================================== */
        /* RESPONSIVIDADE */
        /* ====================================== */

        @media (min-width: 992px) {

            #areaNotificacoes {
                display: flex;
                align-items: center;
            }

            .saudacao-desktop {
                display: flex;
                align-items: center;
            }

        }

        @media (max-width: 991.98px) {

            #areaNotificacoes {
                justify-content: flex-start;
            }

            #menuNotificacoes {
                left: 0;
                right: auto;
            }

        }
    </style>

</head>

<body>


    <!-- ====================================== -->
    <!-- NAVBAR -->
    <!-- ====================================== -->

    <nav class="navbar navbar-expand-lg">

        <div class="container">

            <!-- Logo -->
            <a href="/" class="navbar-brand">

                <img src="/img/ecotech-vetorizado3.svg" alt="EcoTech" width="120">

            </a>


            <!-- Botão abrir menu -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">

                <span class="navbar-toggler-icon" style="filter: brightness(0) invert(1);">
                </span>

            </button>


            <!-- Menu -->
            <div class="collapse navbar-collapse" id="menu">


                <!-- Cabeçalho exclusivo do menu mobile -->
                <div class="menu-mobile-header d-lg-none">

                    <a href="/">

                        <img src="/img/ecotech-vetorizado3.svg" alt="EcoTech" class="logo-menu-mobile">

                    </a>

                    <button type="button" class="btn-fechar-menu" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-label="Fechar menu">

                        <i class="bi bi-x-lg"></i>

                    </button>

                    <% if (nomeUsuario) { %>

                        <div class="saudacao-mobile">
                            Olá, <%= nomeUsuario %>!
                        </div>

                        <% } %>

                </div>


                <!-- Links da navbar -->
                <ul class="navbar-nav ms-auto">


                    <!-- INÍCIO -->
                    <li class="nav-item">

                        <a class="nav-link" href="/">
                            Início
                        </a>

                    </li>


                    <!-- RECICLA -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle" href="/recicla" role="button" data-bs-toggle="dropdown">

                            Recicla

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item" href="/recicla#funciona">
                                    Como funciona
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/recicla#problemas">
                                    Impactos ambientais
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/recicla#impacto-ecotech">
                                    Impacto da EcoTech
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/recicla#impacto">
                                    Dados sobre o impacto
                                </a>
                            </li>

                        </ul>

                    </li>


                    <!-- ECOPRODUTOS -->
                    <li class="nav-item">

                        <a class="nav-link" href="/ecoProdutos">
                            EcoProdutos
                        </a>

                    </li>


                    <!-- SAIBA MAIS -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle" href="/saibamais" role="button" data-bs-toggle="dropdown">

                            Saiba mais

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item" href="/saibamais#sobre">
                                    Sobre a EcoTech
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#circular">
                                    Economia Circular
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#funciona">
                                    Como funciona
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#ecopontos">
                                    EcoPontos
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#lab">
                                    EcoTech Lab
                                </a>
                            </li>

                        </ul>

                    </li>


                    <!-- ====================================== -->
                    <!-- ÁREA DO USUÁRIO -->
                    <!-- ====================================== -->

                    <% if (nomeUsuario) { %>


                        <!-- ACESSO AO PAINEL -->
