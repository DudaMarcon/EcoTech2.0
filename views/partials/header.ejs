<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/img/ecotech-facicon-claro.svg?v=2">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EcoTech</title>

    <!-- Bootstrap -->
<!-- Bootstrap CSS Correto -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/footer.css">
</head>

<body>

    <nav class="navbar navbar-expand-lg">
    <div class="container">

        <!-- Logo -->
        <a href="/" class="navbar-brand">
            <img src="/img/ecotech-vetorizado3.svg"
                 alt="EcoTech"
                 width="150">
        </a>

        <!-- Botão do menu no celular -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menu"
            aria-controls="menu"
            aria-expanded="false"
            aria-label="Abrir ou fechar menu">

            <span
                class="navbar-toggler-icon"
                style="filter: brightness(0) invert(1);">
            </span>
        </button>

            <!-- Links -->
            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Início
                        </a>
                    </li>

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle" href="/recicla" role="button" data-bs-toggle="dropdown"
                            aria-expanded="false">

                            Recicla

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item" href="/recicla#funciona">
                                    Como funciona
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/recicla#problemas">
                                    Impactos ambientais
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/recicla#impacto-ecotech">
                                    Impacto da EcoTech
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/recicla#impacto">
                                    Dados sobre o impacto
                                </a>
                            </li>

                        </ul>

                    </li>

                    <!-- ecoprodutos-->

                     <li class="nav-item">
                        <a class="nav-link" href="/ecoProdutos">
                            EcoProdutos
                        </a>
                    </li>

                    <!-- Saiba mais -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle" href="/saibamais
                        " role="button" data-bs-toggle="dropdown">

                            Saiba mais

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item" href="/saibamais#sobre">
                                    Sobre a EcoTech
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#circular">
                                    Economia Circular
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#funciona">
                                    Como funciona
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#ecopontos">
                                    EcoPontos
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/saibamais#lab">
                                    EcoTech Lab
                                </a>
                            </li>

                        </ul>

                    </li>

<!-- Login / usuário -->
<!-- Login / usuário -->
<% if (nomeUsuario) { %>

    <!-- Usuário logado -->
    <li class="nav-item">
        <span class="nav-link fw-bold">
            Olá, <%= nomeUsuario %>!
        </span>
    </li>

    <!-- Logout -->
    <li class="nav-item">
        <a class="nav-link" href="/logout" title="Sair">
            <img src="/img/sair.png" alt="Logout" width="25">
        </a>
    </li>

<% } else { %>

    <!-- Usuário não logado -->
    <li class="nav-item">
        <a class="nav-link" href="/login">
            Entrar
        </a>
    </li>

<% } %>
                </ul>

            </div>

        </div>
    </nav>

    <!-- Script do Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SCRIPT DE SUPORTE PARA O HOVER NO MENU -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dropdowns = document.querySelectorAll('.navbar .dropdown');

            dropdowns.forEach(dropdown => {
                const menu = dropdown.querySelector('.dropdown-menu');

                dropdown.addEventListener('mouseenter', function () {
                    menu.style.display = 'block';
                });

                dropdown.addEventListener('mouseleave', function () {
                    menu.style.display = 'none';
                });
            });
        });
        document.querySelectorAll('.navbar .dropdown > a.dropdown-toggle').forEach(toggle => {
    toggle.addEventListener('click', function (e) {
        const targetUrl = this.getAttribute('href');
        if (targetUrl && targetUrl !== '#') {
            window.location.href = targetUrl;
        }
    });
});
    </script>

</body>

</html>


