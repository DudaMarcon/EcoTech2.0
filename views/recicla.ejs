<%- include("partials/header") %>

<link rel="stylesheet" href="/css/recicla.css">


<!-- =========================================
     ABERTURA
========================================= -->

<section class="recicla-abertura">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="recicla-label">
                    RECICLA
                </span>

                <h1>
                    Por que é importante
                    <br>
                    reciclar?
                </h1>

                <p>
                    Quando um eletrônico chega ao fim de sua vida útil,
                    seu destino também importa. O descarte correto ajuda
                    a reduzir impactos ambientais e permite recuperar
                    materiais que ainda podem ser aproveitados.
                </p>

                <a href="#impacto" class="btn btn-recicla">
                    Entenda os impactos
                </a>

            </div>

            <div class="col-lg-5 text-center">

                <div class="recicla-symbol">
                    ♻
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================
     IMPACTO DO LIXO ELETRÔNICO
========================================= -->

<section id="impacto" class="recicla-impacto">

    <div class="container">

        <div class="text-center mb-5">

            <span class="section-label">
                O PROBLEMA
            </span>

            <h2>
                O impacto do lixo eletrônico
            </h2>

            <p class="impacto-intro">
                A quantidade de resíduos eletrônicos cresce rapidamente
                em todo o mundo. Quando não são destinados corretamente,
                esses resíduos podem causar impactos no meio ambiente
                e na saúde.
            </p>

        </div>


        <div class="row g-4">

            <!-- DADO 1 -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 impacto-card">

                    <div class="card-body text-center p-4">

                        <strong class="impacto-numero">
                            62 milhões
                        </strong>

                        <h3>
                            de toneladas
                        </h3>

                        <p>
                            de lixo eletrônico foram geradas
                            no mundo em 2022.
                        </p>

                    </div>

                </div>

            </div>


            <!-- DADO 2 -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 impacto-card">

                    <div class="card-body text-center p-4">

                        <strong class="impacto-numero">
                            22,3%
                        </strong>

                        <h3>
                            reciclados adequadamente
                        </h3>

                        <p>
                            foi a parcela documentada como
                            coletada e reciclada corretamente em 2022.
                        </p>

                    </div>

                </div>

            </div>


            <!-- DADO 3 -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 impacto-card">

                    <div class="card-body text-center p-4">

                        <strong class="impacto-numero">
                            82 milhões
                        </strong>

                        <h3>
                            de toneladas
                        </h3>

                        <p>
                            podem ser geradas por ano
                            até 2030.
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <p class="fonte-dados">
            Fonte: Organização Mundial da Saúde (OMS) e
            Global E-waste Monitor 2024.
        </p>

    </div>

</section>


<!-- =========================================
     IMPACTOS AMBIENTAIS
========================================= -->

<section id="problemas" class="recicla-problemas">

    <div class="container">

        <div class="text-center mb-5">

            <span class="section-label">
                DESCARTE INADEQUADO
            </span>

            <h2>
                Quais problemas o lixo eletrônico pode causar?
            </h2>

            <p>
                O descarte inadequado pode liberar substâncias perigosas
                e afetar diferentes partes do meio ambiente.
            </p>

        </div>


        <div class="row g-4">

            <!-- SOLO -->

            <div class="col-md-6 col-lg-3">

                <div class="card border-0 shadow-sm h-100 problema-card">

                    <div class="card-body p-4">

                        <div class="problema-icon">
                            🌱
                        </div>

                        <h3>
                            Solo
                        </h3>

                        <p>
                            Substâncias perigosas podem contaminar
                            o solo quando os resíduos são descartados
                            de maneira inadequada.
                        </p>

                    </div>

                </div>

            </div>


            <!-- ÁGUA -->

            <div class="col-md-6 col-lg-3">

                <div class="card border-0 shadow-sm h-100 problema-card">

                    <div class="card-body p-4">

                        <div class="problema-icon">
                            💧
                        </div>

                        <h3>
                            Água
                        </h3>

                        <p>
                            Resíduos eletrônicos podem liberar
                            substâncias que chegam às águas subterrâneas
                            e fontes de abastecimento.
                        </p>

                    </div>

                </div>

            </div>


            <!-- AR -->

            <div class="col-md-6 col-lg-3">

                <div class="card border-0 shadow-sm h-100 problema-card">

                    <div class="card-body p-4">

                        <div class="problema-icon">
                            🌫️
                        </div>

                        <h3>
                            Ar
                        </h3>

                        <p>
                            Práticas inadequadas, como a queima
                            de resíduos, podem liberar poluentes
                            perigosos no ar.
                        </p>

                    </div>

                </div>

            </div>


            <!-- MATERIAIS -->

            <div class="col-md-6 col-lg-3">

                <div class="card border-0 shadow-sm h-100 problema-card">

                    <div class="card-body p-4">

                        <div class="problema-icon">
                            ♻️
                        </div>

                        <h3>
                            Materiais
                        </h3>

                        <p>
                            O descarte também significa perder
                            materiais valiosos que poderiam ser
                            recuperados e reutilizados.
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <div class="alerta-impacto mt-5">

            <strong>
                Você sabia?
            </strong>

            <p class="mb-0">
                A OMS aponta que mais de 1.000 substâncias nocivas
                podem estar presentes no lixo eletrônico ou ser
                produzidas durante práticas inadequadas de reciclagem,
                incluindo chumbo, mercúrio e cádmio.
            </p>

        </div>

    </div>

</section>


<!-- =========================================
     POR QUE RECICLAR
========================================= -->

<section class="recicla-importancia">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-5">

                <span class="section-label">
                    UMA ESCOLHA IMPORTANTE
                </span>

                <h2>
                    Reciclar ajuda a reduzir esses impactos.
                </h2>

            </div>


            <div class="col-lg-7">

                <p>
                    Dar o destino correto aos eletrônicos permite
                    recuperar materiais e evita que resíduos sejam
                    descartados de maneira inadequada.
                </p>

                <div class="beneficios">

                    <div>
                        <strong>♻ Recuperar</strong>
                        <span>materiais que ainda podem ser aproveitados.</span>
                    </div>

                    <div>
                        <strong>🌱 Reduzir</strong>
                        <span>os impactos causados pelo descarte inadequado.</span>
                    </div>

                    <div>
                        <strong>🔄 Reaproveitar</strong>
                        <span>equipamentos e componentes sempre que possível.</span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================
     COMO FUNCIONA
========================================= -->

