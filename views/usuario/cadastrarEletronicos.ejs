<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cadastrar eletrônico | EcoTech</title>

  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/footer.css" />
  <link rel="stylesheet" href="/css/home.css" />
  <link rel="stylesheet" href="/css/cadastrarEletronicos.css" />
</head>

<body>
  <%- include('../partials/header.ejs') %>

  <main class="main-content">
    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow">
            <div class="card-body">
              <h3 class="text-center mb-4">Cadastrar eletrônico</h3>

              <form
                class="formulario-cadastro"
                action="/cadastrarEletronicos"
                method="POST"
                enctype="multipart/form-data"
              >
                <div class="mb-3">
                  <label for="produto" class="form-label">Produto</label>
                  <select
                    class="select-ecotech"
                    id="produto"
                    name="produto"
                    required
                  >
                    <option value="" selected disabled>
                      Selecione um produto
                    </option>
                    <option value="celular">Celular / Smartphone</option>
                    <option value="computador">Computador / Notebook</option>
                    <option value="desktop">Computador de mesa</option>
                    <option value="tablet">Tablet</option>
                    <option value="televisao">Televisão / Monitor</option>
                    <option value="perifericos">Teclado / Mouse / Periféricos</option>
                    <option value="console">Console de videogame</option>
                    <option value="impressora">Impressora</option>
                    <option value="outro">Outro eletrônico</option>
                  </select>
                </div>

                <!-- Seleção da marca -->
                <div class="mb-3" id="areaMarca" hidden>
                  <label for="marca" class="form-label">Marca</label>
                  <select
                    class="select-ecotech"
                    id="marca"
                    name="marca"
                  >
                    <option value="">Selecione uma marca</option>
                  </select>
                  <small id="statusMarca" class="text-muted"></small>
                </div>

                <!-- Seleção do modelo -->
                <div class="mb-3" id="areaModelo" hidden>
                  <label for="modelo" class="form-label">Modelo</label>
                  <select
                    class="form-control"
                    id="modelo"
                    name="modelo"
                    disabled
                  >
                    <option value="">Selecione primeiro uma marca</option>
                  </select>
                  <small id="statusModelo" class="text-muted"></small>
                </div>

                <div class="mb-3">
                  <label for="armazenamento" class="form-label">
                    Armazenamento
                  </label>
                  <select
                    class="form-control"
                    id="armazenamento"
                    name="armazenamento"
                  >
                    <option value="">Não informado / Não se aplica</option>
                    <option value="32 GB">32 GB</option>
                    <option value="64 GB">64 GB</option>
                    <option value="128 GB">128 GB</option>
                    <option value="256 GB">256 GB</option>
                    <option value="512 GB">512 GB</option>
                    <option value="1 TB">1 TB</option>
                    <option value="2 TB ou mais">2 TB ou mais</option>
                    <option value="Outro">Outro</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="ram" class="form-label">Memória RAM</label>
                  <select class="form-control" id="ram" name="ram">
                    <option value="">Não informado / Não se aplica</option>
                    <option value="2 GB">2 GB</option>
                    <option value="4 GB">4 GB</option>
                    <option value="8 GB">8 GB</option>
                    <option value="16 GB">16 GB</option>
                    <option value="32 GB">32 GB</option>
                    <option value="64 GB ou mais">64 GB ou mais</option>
                  </select>
                </div>

                <div class="mb-3" id="areaTamanhoTela" hidden>
  <label for="tamanhoTela" class="form-label">
    Tamanho da tela
  </label>
  <input
    type="text"
    class="form-control"
    id="tamanhoTela"
    name="tamanhoTela"
    maxlength="30"
    placeholder="Ex.: 15,6 polegadas"
  />
</div>
                <div class="mb-3">
                  <label for="funcionamento" class="form-label">
                    Estado de funcionamento
                  </label>
                  <select
                    class="select-ecotech"
                    id="funcionamento"
                    name="funcionamento"
                    required
                  >
                    <option value="" disabled selected>
                      Selecione uma opção
                    </option>
                    <option value="funcionando">Funcionando normalmente</option>
                    <option value="defeito">Com defeito</option>
                    <option value="danificado">Danificado</option>
                    <option value="nao_testado">Não testado</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="problema" class="form-label">
                    Problema apresentado
                  </label>
                  <textarea
                    id="problema"
                    name="problema"
                    class="form-control"
                    placeholder="Descreva o defeito do eletrônico..."
                    rows="3"
                    maxlength="300"
                    required
                  ></textarea>
                  <div class="d-flex justify-content-between">
                    <small class="text-muted">
                      Informe os defeitos identificados.
                    </small>
                    <span id="contadorproblema">0/300</span>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="descricao" class="form-label">
                    Descrição
                  </label>
                  <textarea
                    id="descricao"
                    name="descricao"
                    class="form-control"
                    placeholder="Detalhes, tempo de uso e outras informações..."
                    rows="4"
                    maxlength="500"
                  ></textarea>
                  <div class="d-flex justify-content-between">
                    <small class="text-muted">
                      Inclua informações relevantes sobre o eletrônico.
                    </small>
                    <span id="contadordescricao">0/500</span>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="foto" class="form-label">
                    Foto do eletrônico
                  </label>
                  <input
                    type="file"
                    id="foto"
                    name="foto"
                    class="form-control"
                    accept="image/jpeg,image/png,image/webp"
                    required
                  />
                  <small class="text-muted">
                    Selecione uma imagem JPEG, PNG ou WebP.
                  </small>
                  <img
                    id="previewFoto"
                    alt="Pré-visualização da foto"
                    style="display:none;max-width:100%;max-height:250px;margin-top:12px;"
                  />
                </div>

                <div class="mb-3">
                  <label for="preco" class="form-label">
                    Preço de venda (R$)
                  </label>
                  <input
                    type="number"
                    id="preco"
                    name="preco"
                    class="form-control"
                    placeholder="Ex.: 1299.90"
                    min="0.01"
                    step="0.01"
                    required
                  />
                </div>

                <button type="submit" class="btn btn-ecotech w-100">
                  Cadastrar
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer.ejs') %>

