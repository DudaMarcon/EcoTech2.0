          "FreeBuds"
        ],

        "Intel": [
          "Core i3",
          "Core i5",
          "Core i7",
          "Core i9",
          "Core Ultra"
        ],

        "AMD": [
          "Ryzen 3",
          "Ryzen 5",
          "Ryzen 7",
          "Ryzen 9",
          "Radeon"
        ],

        "Kingston": [
          "DataTraveler",
          "NV2",
          "A400",
          "Fury"
        ],

        "SanDisk": [
          "Ultra",
          "Extreme",
          "Extreme Pro",
          "Cruzer"
        ],

        "Seagate": [
          "Expansion",
          "Backup Plus",
          "One Touch",
          "Barracuda"
        ],

        "Western Digital": [
          "WD Blue",
          "WD Black",
          "WD My Passport",
          "WD Elements"
        ],

        "Outra / Sem marca específica": [
          "Outro eletrônico",
          "Modelo não identificado"
        ]
      }
    };

    // Quando o usuário escolhe uma categoria
    categoria.addEventListener("change", () => {
      const valorCategoria = categoria.value;
      const marcasDisponiveis = catalogo[valorCategoria];

      // Exibe os campos
      areaMarca.hidden = false;
      areaModelo.hidden = false;

      // Limpa as seleções anteriores
      marca.replaceChildren(
        new Option("Selecione uma marca", "")
      );

      modelo.replaceChildren(
        new Option("Selecione primeiro uma marca", "")
      );

      modelo.disabled = true;

      // Adiciona as marcas da categoria escolhida
      Object.keys(marcasDisponiveis).forEach(nomeMarca => {
        marca.add(new Option(nomeMarca, nomeMarca));
      });

      // Opção de fallback para marcas que não estão no catálogo
      marca.add(
        new Option("Outra marca / Não listada", "Outra marca / Não listada")
      );

      statusMarca.textContent =
        `${Object.keys(marcasDisponiveis).length} marcas disponíveis.`;

      statusModelo.textContent =
        "Selecione uma marca para visualizar os modelos.";
    });

    // Quando o usuário escolhe uma marca
    marca.addEventListener("change", () => {
      const valorCategoria = categoria.value;
      const valorMarca = marca.value;

      modelo.replaceChildren(
        new Option("Selecione um modelo", "")
      );

      modelo.disabled = false;

      if (!valorMarca) {
        modelo.disabled = true;
        statusModelo.textContent = "";
        return;
      }

      const modelosDisponiveis =
        catalogo[valorCategoria][valorMarca] || [];

      // Adiciona os modelos correspondentes à marca
      modelosDisponiveis.forEach(nomeModelo => {
        modelo.add(new Option(nomeModelo, nomeModelo));
      });

      // Alternativa caso o modelo não esteja cadastrado
      modelo.add(
        new Option(
          "Meu modelo não está na lista",
          "Modelo não listado"
        )
      );

      statusModelo.textContent =
        `${modelosDisponiveis.length} modelos disponíveis.`;
    });

    // Pré-visualização da imagem
    const campoFoto = document.getElementById("foto");
    const previewFoto = document.getElementById("previewFoto");

    campoFoto.addEventListener("change", function () {
      const arquivo = this.files[0];

      if (!arquivo) {
        previewFoto.style.display = "none";
        previewFoto.removeAttribute("src");
        return;
      }

      if (!["image/jpeg", "image/png", "image/webp"].includes(arquivo.type)) {
        alert("Selecione uma imagem JPEG, PNG ou WebP.");
        this.value = "";
        previewFoto.style.display = "none";
        previewFoto.removeAttribute("src");
        return;
      }

      previewFoto.src = URL.createObjectURL(arquivo);
      previewFoto.style.display = "block";
    });

    // Contadores de caracteres
    const descricao = document.getElementById("descricao");
    const problema = document.getElementById("problema");

    descricao.addEventListener("input", () => {
      document.getElementById("contadordescricao").textContent =
        `${descricao.value.length}/500`;
    });

    problema.addEventListener("input", () => {
      document.getElementById("contadorproblema").textContent =
        `${problema.value.length}/300`;
    });
  </script>
</body>
</html>