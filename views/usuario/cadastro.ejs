<%- include("../partials/header") %>

<main class="auth-container">
     <link rel="stylesheet" href="/css/loginCadastro.css">

    <section class="auth-card">

        <div class="auth-heading">
            <span class="auth-eyebrow">FAÇA PARTE DO MOVIMENTO</span>

            <h1>Crie sua conta.</h1>

            <p>Comece a fazer parte de um futuro mais sustentável.</p>
        </div>


        <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="auth-error" role="alert">
                <%= erro %>
            </div>
        <% } %>


        <form action="/cadastro" method="POST">

            <div class="auth-field">

                <label for="nome">
                    Nome completo
                </label>

                <input
                    type="text"
                    id="nome"
                    name="nome"
                    placeholder="Seu nome"
                    maxlength="80"
                    required
                >

            </div>


            <div class="auth-field">

                <label for="email">
                    E-mail
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="seuemail@exemplo.com"
                    required
                >

            </div>


            <div class="auth-field">

                <label for="senha">
                    Senha
                </label>

                <input
                    type="password"
                    id="senha"
                    name="senha"
                    placeholder="Mínimo de 6 caracteres"
                    minlength="6"
                    required
                >

            </div>


            <button type="submit" class="auth-submit">
                Criar minha conta
            </button>

        </form>


        <p class="auth-switch">

            Já possui uma conta?

            <a href="/login">
                Entrar
            </a>

        </p>

    </section>

</main>

<%- include("../partials/footer") %>
