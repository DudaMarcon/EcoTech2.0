<%- include("../partials/header") %>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-body">

                    <h3 class="text-center mb-4">
                        Login
                    </h3>

                    <form action="/login" method="POST">

                        <div class="mb-3">

                            <label for="email" class="form-label">
                                E-mail
                            </label>

   <input
    type="email"
    class="form-control <%= (typeof erro !== 'undefined' && erro) ? 'campo-erro' : '' %>"
    id="email"
    name="email"
    placeholder="Digite seu e-mail"
    required
>


                            <small class="form-text text-muted">
                                Seu e-mail será utilizado para acessar sua conta.
                            </small>

                        </div>


                        <div class="mb-3">

                            <label for="senha" class="form-label">
                                Senha
                            </label>
<input
    type="password"
    class="form-control <%= (typeof erro !== 'undefined' && erro) ? 'campo-erro' : '' %>"
    id="senha"
    name="senha"
    placeholder="Digite sua senha"
    required
>

                        </div>

<% if (typeof erro !== 'undefined' && erro) { %>
    <div class="texto-erro mb-3">
        <%= erro %>
    </div>
<% } %>
                        <button
                            type="submit"
                            class="btn btn-ecotech w-100"
                        >
                            Entrar
                        </button>

                    </form>


                    <div class="text-center mt-3">

                        <span>Não possui uma conta?</span>

                        <a href="/cadastro">
                            Cadastre-se
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include("../partials/footer") %>